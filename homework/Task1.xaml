<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task1" Height="365" Width="520"
        Background="#e8e8e8">

    <Border Margin="7, 3, 3, 7" BorderBrush="#999" BorderThickness="1" Background="LightGreen" Padding="8, 8, 8, 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="85"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="CSS GRID" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"/>

            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Content="Header" Margin="4" Height="45"
                    Background="#FF00E62E" BorderBrush="DarkGreen" BorderThickness="2"
                    FontFamily="Segoe UI Semibold" FontSize="14"/>

            <Button Grid.Row="2" Grid.Column="0" Grid.RowSpan="2"
                    Content="Side Bar" Margin="4"
                    Background="#FF00E62E" BorderBrush="DarkGreen" BorderThickness="2"
                    FontFamily="Segoe UI Semibold" FontSize="14"/>

            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                    Content="Content 1" Margin="4"
                    Background="#FF00E62E" BorderBrush="DarkGreen" BorderThickness="2"
                    FontFamily="Segoe UI Semibold" FontSize="14" Padding="0, 5, -35, 15"/>

            <Button Grid.Row="3" Grid.Column="1"
                    Content="Content 2" Margin="4"
                    Background="#FF00E62E" BorderBrush="DarkGreen" BorderThickness="2"
                    FontFamily="Segoe UI Semibold" FontSize="14"/>

            <Button Grid.Row="3" Grid.Column="2"
                    Content="Content 3" Margin="4"
                    Background="#FF00E62E" BorderBrush="DarkGreen" BorderThickness="2"
                    FontFamily="Segoe UI Semibold" FontSize="14"/>

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Content="Footer" Margin="4,0,4,0" Height="70"
                    Background="#FF00E62E" BorderBrush="DarkGreen" BorderThickness="2"
                    FontFamily="Segoe UI Semibold" FontSize="14"/>
        </Grid>
    </Border>
</Window>