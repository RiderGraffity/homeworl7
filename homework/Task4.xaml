<Window x:Class="Task4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task4"
        Width="450" Height="450"
        Background="#1C1C9C">

    <Border Margin="8" Background="#1C1C9C">
        <Grid ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="4"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="8"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="0" Grid.Row="4"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="5" Grid.Row="1"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="6" Grid.Row="1" Grid.ColumnSpan="3"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="5" Grid.Row="2" Grid.ColumnSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="7" Grid.Row="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="8" Grid.Row="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="5" Grid.Row="3" Grid.ColumnSpan="4"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="0" Grid.Row="5"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="0" Grid.Row="6"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="0" Grid.Row="7" Grid.RowSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="1" Grid.Row="4" Grid.RowSpan="5"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>
            
            <Border Grid.Column="2" Grid.Row="4" Grid.RowSpan="3"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>
            
            <Border Grid.Column="2" Grid.Row="7" Grid.RowSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="3" Grid.Row="4" Grid.RowSpan="5"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="4" Grid.Row="4" Grid.RowSpan="5"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="5" Grid.Row="4" Grid.RowSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="6" Grid.Row="4" Grid.RowSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>
            
            <Border Grid.Column="7" Grid.Row="4" Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="5" Grid.Row="6" Grid.ColumnSpan="4"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="7" Grid.Row="7" Grid.ColumnSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="7" Grid.Row="8" Grid.ColumnSpan="4"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>

            <Border Grid.Column="5" Grid.Row="7" Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Background="#C5EAD5" BorderBrush="#1C1C9C" BorderThickness="3"/>
        </Grid>
    </Border>
</Window>