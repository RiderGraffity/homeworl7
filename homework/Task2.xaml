<Window x:Class="Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task2" Height="600" Width="600"
        Background="#F0F0F0"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#2B2B2B" Margin="20, 0, 25, 10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="89*"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="71"/>
            <RowDefinition/>
            <RowDefinition Height="73.04"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                Margin="10,5,10,0" CornerRadius="5"
                Background="#D3D3D3" BorderThickness="2" BorderBrush="#A0A0A0">
            <Button Background="Transparent" Foreground="#808080"
                    FontSize="16" BorderThickness="0">
                Button
            </Button>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" 
                Margin="10,10,10,10" CornerRadius="5"
                Background="#D3D3D3" BorderThickness="2" BorderBrush="#A0A0A0">
            <Button Background="Transparent" Foreground="#808080"
                    FontSize="16" BorderThickness="0">
                Button
            </Button>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                Margin="10,10,10,10" CornerRadius="5"
                Background="#D3D3D3" BorderThickness="2" BorderBrush="#A0A0A0">
            <Button Background="Transparent" Foreground="#808080"
                    FontSize="16" BorderThickness="0">
                Button
            </Button>
        </Border>

        <Border Grid.Column="3" Grid.RowSpan="2"
                Margin="10,5,10,10" CornerRadius="5"
                Background="#D3D3D3" BorderThickness="2" BorderBrush="#A0A0A0">
            <Button Background="Transparent" Foreground="#808080"
                    FontSize="16" BorderThickness="0">
                Button
            </Button>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" 
                Margin="10,0,10,10" CornerRadius="5"
                Background="#D3D3D3" BorderThickness="2" BorderBrush="#A0A0A0">
            <Button Background="Transparent" Foreground="#808080"
                    FontSize="16" BorderThickness="0">
                Button
            </Button>
        </Border>
    </Grid>
</Window>